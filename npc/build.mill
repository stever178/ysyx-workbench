package build

import $ivy.`de.tototec::de.tobiasroeser.mill.vcs.version::0.4.0`
import $ivy.`org.chipsalliance::chisel:7.3.0`
import $ivy.`org.chipsalliance::firtool-resolver:2.0.1`
import de.tobiasroeser.mill.vcs.version.VcsVersion
import java.io.BufferedReader
import java.io.InputStreamReader
import java.time.LocalDateTime
import java.time.format.DateTimeFormatter
import java.util.Locale
import mill._
import mill.scalalib._
import mill.scalalib.scalafmt.ScalafmtModule
import os.Path

val defaultScalaVersion = "2.13.16"
val defaultChiselVersion = "7.0.0"

// val defaultScalaVersion = "2.13.17"
// val defaultChiselVersion = "7.3.0"

// val defaultScalaVersion = "2.13.18"
// val defaultChiselVersion = "7.7.0"

val pwd = os.Path(sys.env("MILL_WORKSPACE_ROOT"))

trait BaseModule extends SbtModule with ScalafmtModule { self =>
  override def scalaVersion = defaultScalaVersion
  def chiselVersion = defaultChiselVersion

  override def scalacOptions = Seq(
    "-language:reflectiveCalls",
    "-deprecation",
    "-feature",
    "-Xcheckinit",
    "-Ymacro-annotations",
    "-Ytasty-reader"
  )

  override def ivyDeps = Agg(
    ivy"org.chipsalliance::chisel:$chiselVersion"
  )

  override def scalacPluginIvyDeps = Agg(
    ivy"org.chipsalliance:::chisel-plugin:$chiselVersion"
  )

  def resolveFirtoolDeps = T {
    firtoolresolver.Resolve(chisel3.BuildInfo.firtoolVersion.get, true) match {
      case Right(bin) => bin.path.getAbsolutePath
      case Left(err)  => err
    }
  }

  def repositoriesTask = Task.Anon {
    Seq(
      coursier.MavenRepository("https://repo1.maven.org/maven2/"),
      coursier.MavenRepository("https://oss.sonatype.org/content/repositories/releases/"),
      coursier.MavenRepository("https://oss.sonatype.org/content/repositories/snapshots/")
    ) ++ super.repositoriesTask()
  }

  trait BaseTests extends SbtTests with TestModule.ScalaTest {
    override def ivyDeps = self.ivyDeps() ++ Agg(
      ivy"org.scalatest::scalatest::3.2.19",
    )

    override def scalacOptions = self.scalacOptions
    override def scalacPluginIvyDeps = self.scalacPluginIvyDeps
    override def moduleDeps = Seq(self)
  }
}

object `rocket-chip` extends BaseModule {
  def chiselVersion = "7.3.0"

  object macros extends ScalaModule {
    def scalaVersion: T[String] = defaultScalaVersion

    def ivyDeps: T[Agg[Dep]] = Agg(ivy"org.scala-lang:scala-reflect:$defaultScalaVersion")
  }

  object hardfloat extends BaseModule {
    def millSourcePath: Path = pwd / "rocket-chip" / "hardfloat" / "hardfloat"
  }

  object cde extends ScalaModule {
    def scalaVersion: T[String] = defaultScalaVersion

    def millSourcePath: Path = pwd / "rocket-chip" / "cde" / "cde"
  }

  def mainClass = Some("freechips.rocketchip.diplomacy.Main")

  def moduleDeps = Seq(macros, hardfloat, cde)

  def ivyDeps: T[Agg[Dep]] = super.ivyDeps() ++ Agg(
      ivy"com.lihaoyi::mainargs:0.7.7", 
      ivy"org.json4s::json4s-jackson:4.0.7",
    )

  object test extends BaseTests {
  }
}

object utils extends BaseModule { m =>
  object test extends BaseTests {
  }
}

object `npc-core` extends BaseModule { m =>
  override def moduleDeps = Seq(utils)
  object test extends BaseTests {
  }
}

object `npc-frontend` extends BaseModule { m =>
  override def moduleDeps = Seq(`npc-core`)
  object test extends BaseTests {
  }
}

object `npc-backend` extends BaseModule { m =>
  override def moduleDeps = Seq(`npc-core`, `rocket-chip`)
  object test extends BaseTests {
  }
}

object `npc-top` extends BaseModule {
  override def moduleDeps = Seq(`npc-frontend`, `npc-backend`)
  object test extends BaseTests {
  }
}

def allTests() = T.command {
  utils.test.runMain("utils.TestFuType")()
  `npc-core`.test.runMain("npc.core.fu.PrintFuType")()
  `npc-core`.test.runMain("npc.core.fu.PrintOpType")()
  `npc-core`.test.runMain("npc.core.isa.PrintImmType")()
  `npc-backend`.test.testOnly("npc.backend.decode.DecoderTest")()
  `npc-backend`.runMain("npc.backend.decode.DecoderElaborate")()
}
